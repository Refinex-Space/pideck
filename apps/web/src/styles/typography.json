{
	"$schema": "./typography.schema.json",
	"metadata": {
		"version": "4.0.0",
		"cssVarPrefix": "tr",
		"classPrefix": "tr"
	},
	"fontFamilies": {
		"interface": {
			"stack": [
				"system-ui",
				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI",
				"Roboto",
				"PingFang SC",
				"PingFang TC",
				"Hiragino Sans",
				"Microsoft YaHei",
				"Apple SD Gothic Neo",
				"Noto Sans CJK SC",
				"sans-serif"
			],
			"kind": "proportional"
		},
		"code": {
			"stack": [
				"JetBrains Mono Variable",
				"JetBrains Mono",
				"Fira Code",
				"SF Mono",
				"Cascadia Code",
				"monospace"
			],
			"kind": "monospace",
			"selfHosted": [
				"@fontsource-variable/jetbrains-mono",
				"@fontsource-variable/jetbrains-mono/wght-italic.css"
			]
		},
		"brand": {
			"$ref": "interface"
		}
	},
	"fontWeights": {
		"regular": 400,
		"medium": 500,
		"semibold": 600
	},
	"fontSizes": {
		"s10": 10,
		"s11": 11,
		"s12": 12,
		"s13": 13,
		"s14": 14,
		"s15": 15,
		"s16": 16,
		"s18": 18,
		"s20": 20,
		"s22": 22,
		"s24": 24,
		"s32": 32
	},
	"lineHeights": {
		"compact": 1.25,
		"metadata": 1.4166666666666667,
		"ui": 1.4285714285714286,
		"code": 1.4615384615384615,
		"relaxed": 1.4615384615384615,
		"default": 1.4166666666666667,
		"reading": 1.6
	},
	"letterSpacings": {
		"normal": "normal",
		"widest": "0.1em"
	},
	"rootStyle": {
		"$ref": "ui.default"
	},
	"codeRow": {
		"fontSize": "s13",
		"lineHeight": "code"
	},
	"textStyles": {
		"brand": {
			"hero": {
				"fontFamily": "brand",
				"fontSize": "s32",
				"fontWeight": "regular",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"heading": {
			"xl": {
				"fontFamily": "interface",
				"fontSize": "s24",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"lg": {
				"fontFamily": "interface",
				"fontSize": "s22",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"md": {
				"fontFamily": "interface",
				"fontSize": "s20",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"sm": {
				"fontFamily": "interface",
				"fontSize": "s18",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"title": {
			"dialog": {
				"fontFamily": "interface",
				"fontSize": "s16",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"card": {
				"$ref": "title.dialog"
			},
			"section": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "medium",
				"lineHeight": "ui",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"compact": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "medium",
				"lineHeight": "metadata",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"entity": {
				"$ref": "ui.default"
			}
		},
		"ui": {
			"default": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "regular",
				"lineHeight": "ui",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"metadata": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "regular",
				"lineHeight": "metadata",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"eyebrow": {
				"$ref": "title.compact"
			},
			"labelPill": {
				"$ref": "title.compact"
			},
			"caption": {
				"fontFamily": "interface",
				"fontSize": "s11",
				"fontWeight": "medium",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"action": {
				"$ref": "title.compact"
			},
			"button": {
				"$ref": "title.section"
			},
			"emphasis": {
				"$ref": "title.compact"
			}
		},
		"body": {
			"reading": {
				"fontFamily": "interface",
				"fontSize": "s15",
				"fontWeight": "regular",
				"lineHeight": "reading",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"code": {
			"text": {
				"fontFamily": "code",
				"fontSize": "s13",
				"fontWeight": "regular",
				"lineHeight": "relaxed",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"document": {
				"fontFamily": "code",
				"fontSize": "s13",
				"fontWeight": "regular",
				"lineHeight": "code",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"otp": {
				"fontFamily": "code",
				"fontSize": "s18",
				"fontWeight": "regular",
				"lineHeight": "metadata",
				"letterSpacing": "widest",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"textSmall": {
				"fontFamily": "code",
				"fontSize": "s11",
				"fontWeight": "regular",
				"lineHeight": "code",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		}
	},
	"proseSystems": {
		"chat": {
			"body": {
				"$ref": "body.reading"
			},
			"h1": {
				"fontFamily": "interface",
				"fontSize": "s18",
				"fontWeight": "medium",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"h2": {
				"fontFamily": "interface",
				"fontSize": "s16",
				"fontWeight": "medium",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"h3": {
				"fontFamily": "interface",
				"fontSize": "s15",
				"fontWeight": "medium",
				"lineHeight": "reading",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"h4": {
				"$ref": "title.compact"
			},
			"h5": {
				"$ref": "title.compact"
			},
			"h6": {
				"$ref": "title.compact"
			},
			"inlineCode": {
				"$ref": "code.text"
			},
			"codeBlock": {
				"$ref": "code.text"
			},
			"blockquote": {
				"$ref": "body.reading"
			},
			"list": {
				"$ref": "body.reading"
			},
			"tableBody": {
				"$ref": "body.reading"
			},
			"tableHeader": {
				"$ref": "title.section"
			},
			"tableInlineCode": {
				"$ref": "code.text"
			}
		},
		"doc": {
			"body": {
				"$ref": "body.reading"
			},
			"h1": {
				"$ref": "heading.xl"
			},
			"h2": {
				"$ref": "heading.lg"
			},
			"h3": {
				"$ref": "heading.md"
			},
			"h4": {
				"$ref": "heading.sm"
			},
			"h5": {
				"$ref": "title.dialog"
			},
			"h6": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"inlineCode": {
				"$ref": "code.text"
			},
			"codeBlock": {
				"$ref": "code.document"
			},
			"blockquote": {
				"$ref": "body.reading"
			},
			"list": {
				"$ref": "body.reading"
			},
			"tableBody": {
				"$ref": "body.reading"
			},
			"tableHeader": {
				"$ref": "title.dialog"
			},
			"tableInlineCode": {
				"$ref": "code.text"
			}
		}
	}
}
